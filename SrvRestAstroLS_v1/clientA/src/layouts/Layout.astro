---
// Layout.astro
import "../styles/global.css";

interface Props {
  title: string;
  theme_daisyui: string;
  metaDescription?: string;
  canonicalUrl?: string;
}

const {
  title,
  theme_daisyui,
  metaDescription = "Concilia FCE: herramienta de conciliación bancaria y contable.",
  canonicalUrl
} = Astro.props;

const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Concilia FCE",
  "description": metaDescription,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web"
};

const pageUrl = canonicalUrl ?? Astro.url.href;
---

<!DOCTYPE html>
<html lang="es" data-theme={theme_daisyui}>
  <head>
    <!-- Básico -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Concilia FCE</title>
    <meta name="description" content={metaDescription} />

    <!-- Canonical -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="/assets/concilia-fce.png" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {JSON.stringify(appJsonLd)}
    </script>
  </head>

  <body class="min-h-screen bg-base-100 text-base-content">
    <slot />
  </body>
</html>

<style is:global>
  /* 🎨 Overrides compatibles con DaisyUI (usa tokens de tema) */
  /* Para cualquier tema activo vía data-theme */
  html {
    /* Primary */
    --p: 34 92% 40%;      /* HSL (h s l /% sin la barra) DaisyUI espera este formato */
    --pc: 0 0% 100%;
    /* Secondary opcional */
    --s: 219 86% 47%;
    --sc: 0 0% 100%;
  }

  /* Si querés solo cuando el tema sea emerald */
  html[data-theme="emerald"] {
    --p: 142 76% 36%;
    --pc: 0 0% 100%;
  }
</style>
